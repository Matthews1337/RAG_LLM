DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres + pgvector (docker compose)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5433
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# Ollama (docker compose): embeddings e modelos open source
OLLAMA_BASE_URL=http://localhost:11434

# Modelo de embeddings no formato provedor:modelo. Trocar exige `python manage.py reindex`.
EMBEDDING_MODEL=ollama:bge-m3
EMBEDDING_DIMENSIONS=1024

# Modelos exibidos no chat (provedor:modelo). Os pagos só aparecem se a chave estiver preenchida.
LLM_MODELS=ollama:qwen2.5:3b,anthropic:claude-sonnet-5-5,anthropic:claude-haiku-5-5,openai:gpt-5-mini,google_genai:gemini-flash-latest
DEFAULT_LLM_MODEL=ollama:qwen2.5:3b
# Modelo que reescreve e classifica a pergunta. Vazio = usa o mesmo escolhido no chat.
ROUTER_LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
